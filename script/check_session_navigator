rg -q 'resume_post_prompt_replacing_legacy_or_provider_title_seed' docs/specs/SESSION_NAVIGATOR_SPEC.yaml
rg -q 'resume_legacy_title_seed_survives_post_resume_prompt' src/ui/session_navigator.rs
rg -q 'resume_provider_only_title_seed_survives_history_gap_and_second_prompt' src/ui/session_navigator.rs
rg -q 'resume_typed_first_user_seed_remains_write_once_after_second_prompt' src/ui/session_navigator.rs
rg -q 'resume_both_title_candidates_keep_provider_precedence_after_second_prompt' src/ui/session_navigator.rs
rg -q 'resume_title_candidates_bridge_legacy_title_into_provider_slot' crates/agentty-core/src/agent_runtime/navigator.rs
rg -q 'PaneSetProviderTitle' src/ui/tree_sync.rs crates/agentty-core/src/daemon/control.rs crates/agentty-core/src/host/server.rs
