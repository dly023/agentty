#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

# `rg -q` exits on the first match. Under pipefail that can SIGPIPE an upstream
# awk/rg producer and turn a successful content assertion into a random failure.
# Pipeline predicates must consume their complete input instead.
rg_consume() {
  rg "$@" >/dev/null
}
required=(
  src/ui/session_navigator.rs
  src/ui/tab_sidebar.rs
  crates/agentty-core/src/agent_runtime/navigator.rs
  crates/agentty-core/src/agent_runtime/resume.rs
)
for path in "${required[@]}"; do
  [[ -f "$path" ]] || { echo "[session-navigator] missing $path" >&2; exit 1; }
done
rg -q 'RemoteAgentRuntime::new' src/ui/environment_session.rs
rg -q 'EnvironmentSessionContext::resolve' src/ui/session_navigator.rs
rg -q 'session_user_state_path' src/ui/environment_session.rs src/ui/session_navigator.rs
if rg -n 'SessionUserStateStore::path\(' src/ui/session_navigator.rs; then
  echo '[session-navigator] Environment-scoped Navigator must consume the target AgentStoreRoots user-state path' >&2
  exit 1
fi
rg -q 'run_invocation\(&invocation, cx\)' src/ui/session_navigator.rs src/ui/app.rs
rg -q 'navigator_row_id' src/ui/pending_pane.rs src/ui/app.rs src/ui/session_navigator.rs
rg -q 'agent-session-navigator-list' src/ui/tab_sidebar.rs
rg -q 'RestoreOutcome::Retryable' src/ui/app.rs src/ui/session_navigator.rs
rg -q 'row\.agent\.icon_path\(\)' src/ui/tab_sidebar.rs
rg -q 'row\.agent\.accent_rgb\(\)' src/ui/tab_sidebar.rs
rg -q 'navigator_rows_use_their_agent_icon' src/ui/tab_sidebar.rs
if rg -n 'IconName::Bot|IconName::SquareTerminal' src/ui/tab_sidebar.rs; then
  echo '[session-navigator] provider-owned rows must use canonical CLI Agent icons' >&2
  exit 1
fi
rg -q 'DiscoveryRequest::standard' src/ui/session_navigator.rs
rg -q 'ProviderScanner::OmpJsonl => discover_omp' crates/agentty-core/src/agent_runtime/service.rs
rg -q 'omp_discovery_reads_one_project_level_and_ignores_diagnostic_only_files' crates/agentty-core/src/agent_runtime/service.rs
rg -q 'SESSION-GROK-DISCOVERY-31' docs/specs/SESSION_NAVIGATOR_SPEC.yaml
rg -q 'SESSION-GEMINI-DISCOVERY-32' docs/specs/SESSION_NAVIGATOR_SPEC.yaml
rg -q 'SESSION-DISCOVERY-TIMEOUT-VISIBLE-33' docs/specs/SESSION_NAVIGATOR_SPEC.yaml
rg -q 'SESSION-JCODE-STABLE-LIST-GATE-34' docs/specs/SESSION_NAVIGATOR_SPEC.yaml
rg -q 'jcode_uses_documented_session_schema' crates/agentty-core/src/agent_runtime/provider.rs
rg -q 'jcode_complete_document_mapping_keeps_large_sessions_resumable' crates/agentty-core/src/agent_runtime/service.rs
rg -q 'jcode_newest_candidate_limit_uses_file_mtime_before_card_timestamps' crates/agentty-core/src/agent_runtime/service.rs
if awk '/fn discover_jcode_session_files/{p=1} p{print} /fn jcode_message_text/{exit}' crates/agentty-core/src/agent_runtime/service.rs | rg -n 'read_file_prefix'; then
  echo '[session-navigator] complete Jcode JSON must not be parsed from a truncated prefix' >&2
  exit 1
fi
rg -q 'ProviderId::Grok' crates/agentty-core/src/agent_runtime/provider.rs
rg -q 'ProviderId::Gemini' crates/agentty-core/src/agent_runtime/provider.rs
rg -q 'ProviderScanner::GrokSummaryJson' crates/agentty-core/src/agent_runtime/provider.rs crates/agentty-core/src/agent_runtime/service.rs
rg -q 'ProviderScanner::GeminiTmpJsonl' crates/agentty-core/src/agent_runtime/provider.rs crates/agentty-core/src/agent_runtime/service.rs
