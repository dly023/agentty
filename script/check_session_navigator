rg -q 'grok_discovery_reads_summary_json_and_ignores_sibling_caches' crates/agentty-core/src/agent_runtime/service.rs
rg -q 'gemini_discovery_reads_tmp_chats_and_skips_session_context_titles' crates/agentty-core/src/agent_runtime/service.rs
rg -q 'gemini_discovery_ignores_antigravity_cli_tree' crates/agentty-core/src/agent_runtime/service.rs
rg -q 'grok_summary_requires_directory_identity_match' crates/agentty-core/src/agent_runtime/service.rs
