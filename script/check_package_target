#!/usr/bin/env bash
set -euo pipefail
if [[ $# != 3 ]]; then
  echo 'usage: check_package_target <target> <arch> <platform>' >&2
  exit 2
fi
case "$3:$1:$2" in
  macos:aarch64-apple-darwin:arm64|macos:x86_64-apple-darwin:x86_64) ;;
  linux:aarch64-unknown-linux-gnu:arm64|linux:aarch64-unknown-linux-gnu:aarch64|linux:x86_64-unknown-linux-gnu:x86_64) ;;
  windows:x86_64-pc-windows-msvc:x86_64) ;;
  *) echo 'unsupported package platform/target/architecture tuple' >&2; exit 2 ;;
esac
