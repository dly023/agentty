#!/bin/sh
set -eu
rg -q 'fn key_account_from_local_file' src/core/keychain.rs
for file in src/ui/ssh_connect.rs src/ui/ssh_prompt.rs src/ui/settings.rs; do
    rg -q 'key_account_from_local_file' "$file"
done
if sed '/^#\[cfg(test)\]/,$d' src/ui/ssh_prompt.rs | rg -q 'std::fs::read|key_account_from_contents'; then
    exit 1
fi
