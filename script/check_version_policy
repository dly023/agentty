#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
expected=0.0.1
actual=$(awk '/^\[workspace.package\]/{inside=1; next} inside && /^version = /{gsub(/version = |"/, ""); print; exit}' Cargo.toml)
[[ "$actual" == "$expected" ]] || {
  echo "[version] Cargo.toml workspace version must be $expected before push; found ${actual:-missing}" >&2
  exit 1
}
# Cargo.lock may contain many third-party versions. Require every local package name to use the policy version.
for package in agentty agentty-core agentty-server agentty-cli; do
  awk -v package="$package" -v expected="$expected" '
    $0 == "name = \"" package "\"" { found=1; getline; if ($0 != "version = \"" expected "\"") bad=1 }
    END { exit (!found || bad) }
  ' Cargo.lock || { echo "[version] Cargo.lock local package $package must be $expected" >&2; exit 1; }
done
rg -q 'fn source_tree_fingerprint' crates/agentty-core/build.rs || {
  echo '[version] build identity must include the exact remote-server source closure' >&2
  exit 1
}
rg -q '../agentty-server/src' crates/agentty-core/build.rs || {
  echo '[version] build identity must include agentty-server sources, not core alone' >&2
  exit 1
}
echo "version policy checks passed ($expected)"
