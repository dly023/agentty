rg -q 'h.validate_agent_session\(' crates/tty7-core/src/host/server.rs
if sed -n '/fn validate_agent_session(/,/^    }/p' crates/tty7-core/src/host/remote.rs | rg -q 'LocalHost|validate_current_process|std::fs'; then
    exit 1
fi
if sed -n '/fn agent_sessions(/,/^    }/p' crates/tty7-core/src/host/remote.rs | rg -q 'LocalHost|scan_current_process|std::fs'; then
    exit 1
fi
